# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

min-release-age=14
# allow assistant-ui packages & a couple specific deps since they update a LOT.
# remove this when we stabilize (or we haven't updated in 2 wks)
min-release-age-exclude[]=@assistant-ui/*
min-release-age-exclude[]=assistant-cloud
min-release-age-exclude[]=assistant-stream
min-release-age-exclude[]=@radix-ui/*
min-release-age-exclude[]=radix-ui
min-release-age-exclude[]=safe-content-frame

# fast-uri 3.1.9 includes fixes for the 3.0.0 - 3.1.8 advisories (build only). remove when > 2wks old (rel 2026-10-19; remove on 2026-11-02)
min-release-age-exclude[]=fast-uri

# ink needs
min-release-age-exclude[]=lightningcss
min-release-age-exclude[]=postcss

# postcss-selector-parser 6.1.5 includes fixes for GHSA-rj75-hqrm-r3gf (CSS build only). remove when > 2wks old (rel 2026-10-19; remove on 2026-11-02)
min-release-age-exclude[]=postcss-selector-parser

# electron 44.10.1: latest patch of Electron 44 (42 is end-of-life; every 45.x is under 14 days old). Every release
# that fixes GHSA-jr5w-w6x2-84p9 (42.11.16 / 43.8.1 / 44.9.1 and later) was published on 2026-10-20 or later, so
# any fixing release needs this exclusion.
# electron 44.10.1 was released on 2026-10-31; remove this on 2026-11-14.
min-release-age-exclude[]=electron

# follow-redirects 1.16.2 fixes GHSA-mrwp-f3q8-3g9p (high; dev path via axios).
# follow-redirects 1.16.2 was released on 2026-10-25; remove this on 2026-11-08.
min-release-age-exclude[]=follow-redirects

# joi 18.3.1 fixes GHSA-4528-x5fx-h6hg (high; dev path via wait-on).
# joi 18.3.1 was released on 2026-10-28; remove this on 2026-11-11.
min-release-age-exclude[]=joi
