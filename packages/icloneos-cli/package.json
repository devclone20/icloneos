{
  "name": "@icloneos/cli",
  "version": "0.1.0",
  "description": "Thin, verifying launcher for the iclone os macOS app: install, launch, update, uninstall.",
  "license": "MIT",
  "author": "CLONE FRAME (https://cloneframe.io)",
  "homepage": "https://cloneframe.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devclone20/icloneos-cli.git",
    "directory": "packages/icloneos-cli"
  },
  "type": "module",
  "bin": {
    "icloneos": "bin/icloneos.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "6.0.3"
  }
}
