# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

min-release-age=14

# fast-uri 3.1.9 includes fixes for GHSA-qw65-cvwx-89v3, GHSA-5jgf-p345-68v8, GHSA-f65p-4m7j-42xc, GHSA-fph4-wmhf-6fwf, GHSA-jqff-g426-hqxp. remove when > 2wks old (rel 2026-10-19, remove after 2026-11-02)
min-release-age-exclude[]=fast-uri

# body-parser 1.20.9 includes fixes for GHSA-27r3-jxmh-p828. remove when > 2wks old (rel 2026-10-22, remove after 2026-11-05)
min-release-age-exclude[]=body-parser

# follow-redirects 1.16.2 includes fixes for GHSA-mrwp-f3q8-3g9p, GHSA-q3jh-wrc6-jgq8, GHSA-8r9p-f939-6h3c. remove when > 2wks old (rel 2026-10-25, remove after 2026-11-08)
min-release-age-exclude[]=follow-redirects

# joi 17.13.9 includes fixes for GHSA-4528-x5fx-h6hg, GHSA-6h2x-m376-mqjq. remove when > 2wks old (rel 2026-10-28, remove after 2026-11-11)
min-release-age-exclude[]=joi
